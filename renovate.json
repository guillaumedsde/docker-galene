{
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile[^/]*$"],
      "matchStrings": [
        "ADD\\s+(?:--\\S+\\s+)*(?<packageName>https?://\\S+?\\.git)#(?<currentDigest>[0-9a-f]{7,40})"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ]
}
